---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<img src="/logo-mundo-digital.png" alt={SITE_TITLE} class="nav-logo" />
			</a>
		</h2>
		
		<!-- Botón Hamburguesa (Solo visible en celulares) -->
		<button class="menu-toggle" aria-label="Abrir menú">
			<span class="bar"></span>
			<span class="bar"></span>
			<span class="bar"></span>
		</button>

		<!-- Enlaces del Menú -->
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Artículos</HeaderLink>
			<HeaderLink href="/about">Acerca de</HeaderLink>
		</div>
	</nav>
</header>

<script>
	// JavaScript para alternar la clase active al hacer clic
	const menuToggle = document.querySelector('.menu-toggle');
	const internalLinks = document.querySelector('.internal-links');

	menuToggle?.addEventListener('click', () => {
		menuToggle.classList.toggle('active');
		internalLinks?.classList.toggle('active');
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #0d1117;
		border-bottom: 1px solid #30363d;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 70px;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	.nav-logo {
		height: 40px;
		width: auto;
		display: block;
	}
	.internal-links {
		display: flex;
		gap: 1em;
	}
	header a {
		padding: 0.5em 0.5em;
		color: #c9d1d9;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	header a:hover,
	header a.active {
		color: #58a6ff;
	}

	/* Estilos del Botón Hamburguesa */
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: space-between;
		width: 30px;
		height: 21px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 110;
	}
	.menu-toggle .bar {
		width: 100%;
		height: 3px;
		background-color: #c9d1d9;
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	/* Diseño Adaptativo (Mobile First para el menú oculto) */
	@media (max-width: 720px) {
		.menu-toggle {
			display: flex;
		}
		.internal-links {
			display: none;
			flex-direction: column;
			position: absolute;
			top: 70px;
			left: 0;
			width: 100%;
			background: #0d1117;
			border-bottom: 1px solid #30363d;
			padding: 1em 0;
			gap: 0;
			box-shadow: 0 10px 15px rgba(0, 0, 0, 0.5);
		}
		.internal-links.active {
			display: flex;
		}
		header a {
			width: 100%;
			text-align: center;
			padding: 1em 0;
			border-bottom: none;
		}
		
		/* Animación de Hamburguesa a Cruz (X) */
		.menu-toggle.active .bar:nth-child(1) {
			transform: translateY(9px) rotate(45deg);
		}
		.menu-toggle.active .bar:nth-child(2) {
			opacity: 0;
		}
		.menu-toggle.active .bar:nth-child(3) {
			transform: translateY(-9px) rotate(-45deg);
		}
	}
</style>
